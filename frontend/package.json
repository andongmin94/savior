{
  "name": "savior",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "andongmin94 (React, Electron)",
  "description": "React and Electron client for personalized welfare service discovery",
  "main": "src/electron/main.js",
  "build": {
    "appId": "io.github.andongmin94.savior",
    "mac": {
      "icon": "public/icon.png"
    },
    "win": {
      "icon": "public/icon.png"
    },
    "productName": "Savior",
    "copyright": "Copyright © 2024 D109 K-ASAP",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "node_modules/**/*",
      "public/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist_electron"
    },
    "extends": null
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "elec": "electron .",
    "app": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run elec\"",
    "app:demo": "concurrently -k \"npm run demo\" \"wait-on http://localhost:3000 && npm run elec\"",
    "app:build": "electron-builder",
    "test": "node --test src/mocks/mockAdapter.test.js",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.13",
    "@mui/material": "^5.15.13",
    "axios": "^1.6.7",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.3",
    "redux": "^5.0.1",
    "swiper": "^14.0.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^8.1.4",
    "wait-on": "^7.2.0"
  }
}
